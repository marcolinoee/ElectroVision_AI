# =============================================================================
# ElectroVision AI — Environment Configuration Example (100% Local-First)
# =============================================================================

# Application
ELECTROVISION_ENV=development
ELECTROVISION_LOG_LEVEL=INFO
ELECTROVISION_CONFIDENCE_THRESHOLD=0.80

# Compute Device (cpu | cuda) — Use docker-compose.gpu.yml for cuda
ELECTROVISION_DEVICE=cpu

# PostgreSQL 16 + pgvector
POSTGRES_USER=electrovision
POSTGRES_PASSWORD=electrovision_local_secret
POSTGRES_DB=electrovision
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5435
DATABASE_URL=postgresql+asyncpg://electrovision:electrovision_local_secret@postgres:5432/electrovision
DATABASE_SYNC_URL=postgresql+psycopg://electrovision:electrovision_local_secret@postgres:5432/electrovision

# Redis (Celery Broker/Backend + SSE Pub/Sub)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6380
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Host Ports (non-conflicting with existing Docker containers)
API_HOST_PORT=8030
FRONTEND_HOST_PORT=3030

# Storage Root (mounted volume ./storage -> /app/storage)
STORAGE_ROOT=/app/storage

# Upload & AppSec Limits
MAX_IMAGE_UPLOAD_MB=25
MAX_VIDEO_UPLOAD_MB=250
MAX_DXF_UPLOAD_MB=50
MAX_PDF_UPLOAD_MB=100
MAX_IMAGE_PIXELS=40000000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8030
