# =============================================================================
# Stage 1: Builder (uv + ML stack: strict CPU-only ~180MB torch or explicit CUDA)
# =============================================================================
FROM python:3.12-slim AS builder

ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
ARG TORCH_PKG="torch==2.5.1+cpu"
ARG TORCHVISION_PKG="torchvision==0.20.1+cpu"

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /app

COPY pyproject.toml uv.lock ./
# 1. Install base locked deps
RUN uv sync --frozen --no-dev --no-install-project

# 2. Install strict CPU or CUDA wheel for torch/torchvision (never pulls 6GB CUDA on CPU!)
RUN uv pip install --python /app/.venv/bin/python \
    --index-url ${TORCH_INDEX_URL} \
    --extra-index-url https://pypi.org/simple \
    --index-strategy unsafe-best-match \
    "${TORCH_PKG}" "${TORCHVISION_PKG}"

# 3. Install vision ML packages without upgrading torch
RUN uv pip install --python /app/.venv/bin/python --no-deps \
    "ultralytics>=8.3.0,<8.4.0" "easyocr>=1.7.2,<2.0.0" \
    && uv pip install --python /app/.venv/bin/python \
    --index-url https://pypi.org/simple \
    "opencv-python-headless>=4.10.0,<5.0.0" \
    "scikit-learn>=1.5.2,<2.0.0" \
    "numpy>=1.26.4,<2.2.0" \
    "scipy>=1.13.0,<2.0.0" \
    "matplotlib>=3.9.0,<4.0.0" \
    "requests>=2.32.0,<3.0.0" \
    "tqdm>=4.66.0,<5.0.0" \
    "psutil>=6.0.0,<7.0.0" \
    "py-cpuinfo>=9.0.0,<10.0.0" \
    "ultralytics-thop>=2.0.0,<3.0.0" \
    "scikit-image>=0.24.0,<1.0.0" \
    "python-bidi>=0.6.0,<1.0.0" \
    "Shapely>=2.0.0,<3.0.0" \
    "pyclipper>=1.3.0,<2.0.0" \
    "ninja>=1.11.0,<2.0.0" \
    "imagehash>=4.3.1,<5.0.0" \
    "datasets>=3.0.0,<4.0.0"

COPY app ./app
RUN uv pip install --python /app/.venv/bin/python --no-deps .

# =============================================================================
# Stage 2: Runtime (Isolated ML Celery Worker: vision_queue, train_queue)
# =============================================================================
FROM python:3.12-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 appuser \
    && useradd --uid 10001 --gid appuser --shell /bin/false --create-home appuser

WORKDIR /app

COPY --from=builder --chown=appuser:appuser /app/.venv /app/.venv
COPY --from=builder --chown=appuser:appuser /app/app /app/app

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    OMP_NUM_THREADS=4

USER appuser

CMD ["celery", "-A", "app.core.celery_app:celery_app", "worker", "-Q", "vision_queue,train_queue", "--include=app.services.vision.pipeline,app.services.ml_ops.yolo_trainer,app.services.ml_ops.harvester.pipeline", "--concurrency=1", "--loglevel=info"]
